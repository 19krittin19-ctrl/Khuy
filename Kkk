--[[
    BlockSpin ULTIMATE FINAL
    รวมทุกฟีเจอร์:
    X = หมุนบล็อก (ล็อกหัวแบบไม่หัน)
    C = ดำดิน/กลับหัว
    V = ESP มองเห็นของคนอื่น
    B = ยิงทะลุกำแพง
]]

-- ===== การตั้งค่า =====
local spinSpeed = 10
local radius = 5
local toggleKey = Enum.KeyCode.X
local noclipKey = Enum.KeyCode.C
local espKey = Enum.KeyCode.V
local wallbangKey = Enum.KeyCode.B

-- ===== ตัวแปรหลัก =====
local player = game.Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoidRootPart = character:WaitForChild("HumanoidRootPart")
local humanoid = character:WaitForChild("Humanoid")
local spinning = false
local spinPart = nil
local noclipEnabled = false
local espEnabled = false
local wallbangEnabled = false

-- ===== ฟังก์ชันสร้างบล็อก =====
local function createSpinPart()
    local part = Instance.new("Part")
    part.Size = Vector3.new(2, 2, 2)
    part.BrickColor = BrickColor.new("Really red")
    part.Material = Enum.Material.Neon
    part.Anchored = true
    part.CanCollide = false
    part.Transparency = 0.3
    part.Parent = workspace
    return part
end

-- ===== ฟังก์ชันหมุนบล็อก (ล็อกหัวแบบไม่หัน) =====
local function spinBlock()
    if not spinPart then
        spinPart = createSpinPart()
    end
    
    local startTime = tick()
    
    while spinning do
        local elapsed = tick() - startTime
        local angle = math.rad(elapsed * spinSpeed)
        
        -- หมุนบล็อกรอบตัว แต่ไม่บังคับให้หัวหันตาม
        local offset = Vector3.new(math.cos(angle) * radius, 2, math.sin(angle) * radius)
        spinPart.CFrame = humanoidRootPart.CFrame * CFrame.new(offset)
        
        -- ทำให้บล็อกหมุนรอบตัวเอง
        spinPart.CFrame = spinPart.CFrame * CFrame.Angles(0, math.rad(90) * spinSpeed * 0.1, 0)
        
        wait(0.016)
    end
    
    if spinPart then
        spinPart:Destroy()
        spinPart = nil
    end
end

-- ===== ฟังก์ชันดำดิน/กลับหัว =====
local function toggleNoclip()
    noclipEnabled = not noclipEnabled
    
    if noclipEnabled then
        -- กลับหัว
        humanoidRootPart.CFrame = humanoidRootPart.CFrame * CFrame.Angles(math.pi, 0, 0)
        
        -- Noclip
        for _, part in ipairs(character:GetChildren()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
        
        -- ดำดิน
        humanoidRootPart.Velocity = Vector3.new(0, -50, 0)
        
        spawn(function()
            while noclipEnabled do
                for _, part in ipairs(character:GetChildren()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
                wait(0.1)
            end
        end)
        
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "Noclip ON",
            Text = "ดำดินแล้ว! กด C เพื่อกลับ",
            Duration = 3
        })
    else
        humanoidRootPart.CFrame = humanoidRootPart.CFrame * CFrame.Angles(math.pi, 0, 0)
        
        for _, part in ipairs(character:GetChildren()) do
            if part:IsA("BasePart") then
                part.CanCollide = true
            end
        end
        
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "Noclip OFF",
            Text = "กลับสู่ปกติแล้ว!",
            Duration = 3
        })
    end
end

